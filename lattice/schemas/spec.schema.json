{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "examples": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3,}(-EX[0-9]{3,})?$",
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "draft",
        "retired"
      ],
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "items": {
        "oneOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "owner",
    "status",
    "description"
  ],
  "title": "Lattice canonical spec",
  "type": "object"
}
